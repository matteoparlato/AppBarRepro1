                                  OnClick="ShowSuccessAsync" />
                <FluentAppBarItem Href="@(null)"
                                  IconRest="IconsIcon()"
                                  IconActive="IconsIcon(active: true)"
                                  Text="Icons"
                                  OnClick="HandleOnClick" />
                <FluentAppBarItem Href="/Dialog"
                                  IconRest="DialogIcon()"
                                  IconActive="DialogIcon(active: true)"
                                  Text="Dialog"
                                  OnClick="HandleOnClick" />
            </FluentAppBar>
        </FluentStack>
    </FluentLayoutItem>

    <!-- Content -->
    <FluentLayoutItem Area="@LayoutArea.Content"
                      Padding="@Padding.All3">
        <h1>Hello, world!</h1>

        Welcome to your new Fluent Blazor app.
    </FluentLayoutItem>

    <!-- Footer -->
